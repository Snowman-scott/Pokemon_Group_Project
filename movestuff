import random
from typing import List, Optional
class Move:
# represents a pokemon move with PP tracking
    def init(self, name: str, move_type: str, category: str, power: int, accuracy: int, max_pp: int):
        self.name = name
        self.type = move_type
        self.category = category  # physical, special, or status
        self.power = power
        self.accuracy = accuracy
        self.max_pp = max_pp
        self.current_pp = max_pp
        self.pp_ups_used = 0
def use(self) -> bool:
    # use the move, reducing PP by 1. returns True if successful.
    if self.current_pp > 0:
        self.current_pp -= 1
        return True
    return False

def restore(self, amount: int = None):
    # restore PP. if amount is None, fully restore.
    if amount is None:
        self.current_pp = self.max_pp
    else:
        self.current_pp = min(self.current_pp + amount, self.max_pp)

def __str__(self):
    return f"{self.name} ({self.category}) - {self.current_pp}/{self.max_pp} PP"
class Pokemon:
# represents a pokemon with moves
    def init(self, name: str, types: dict, moves: List[Move], hp: int = 100):
        self.name = name
        self.type1 = types.get("type1", "")
        self.type2 = types.get("type2", "")
        self.moves = moves[:4]  # max 4 moves
        self.hp = hp
        self.max_hp = hp
def select_move(self, move_index: int) -> Optional[Move]:
    # select a move by index (0-3)
    if 0 <= move_index < len(self.moves):
        return self.moves[move_index]
    return None

def use_move(self, move_index: int, target) -> tuple[bool, str, int]:
    # attempt to use a move against target. 
    # returns (success, message, damage_dealt).
    
    move = self.select_move(move_index)
    
    if move is None:
        return False, "Invalid move selection!", 0
    
    if move.current_pp == 0:
        return False, f"{move.name} has no PP left!", 0
    
    # use the move
    move.use()
    
    # sim accuracy check
    hit = random.randint(1, 100) <= move.accuracy
    
    if not hit:
        return True, f"{self.name} used {move.name}, but it missed!", 0
    
    # calc damage
    damage = 0
    if move.power > 0:
        # basic damage calculation
        damage = int(move.power * random.uniform(0.85, 1.0))
        target.hp = max(0, target.hp - damage)
        return True, f"{self.name} used {move.name}! Dealt {damage} damage!", damage
    else:
        # status move
        return True, f"{self.name} used {move.name}!", 0

def struggle(self, target) -> tuple[str, int]:
    # use struggle when all moves are out of PP
    recoil = self.max_hp // 4
    self.hp = max(0, self.hp - recoil)
    damage = 50
    target.hp = max(0, target.hp - damage)
    return f"{self.name} used Struggle! Dealt {damage} damage but took {recoil} recoil damage!", damage

def all_moves_depleted(self) -> bool:
    # check if all moves have 0 PP
    return all(move.current_pp == 0 for move in self.moves)

def heal_at_center(self):
    # fully restore all PP and HP
    for move in self.moves:
        move.restore()
    self.hp = self.max_hp

def display_moves(self):
    # display all moves with their current PP
    print(f"\n{self.name}'s Moves:")
    for i, move in enumerate(self.moves):
        print(f"  {i+1}. {move}")

def is_alive(self) -> bool:
    # check if Pokémon can still battle
    return self.hp > 0

